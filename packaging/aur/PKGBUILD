# Maintainer: Halit Sever <halitsever at users dot noreply dot github dot com>
pkgname=claudegrid
pkgver=1.1.0
pkgrel=1
pkgdesc="Run several Claude Code agents side by side in Konsole, tmux, kitty or WezTerm"
arch=('any')
url="https://github.com/halitsever/claudegrid"
license=('MIT')
depends=('nodejs>=20')
makedepends=('npm')
optdepends=(
  'tmux: tmux backend, works in any terminal'
  'konsole: KDE Konsole backend'
  'qt6-tools: qdbus6 for the Konsole backend'
  'kitty: kitty backend'
  'wezterm: WezTerm backend'
  'git: worktrees'
)
source=("$pkgname-$pkgver.tgz::https://github.com/halitsever/claudegrid/releases/download/v$pkgver/claudegrid.tgz")
noextract=("$pkgname-$pkgver.tgz")
sha256sums=('b60c8aadf5975f1ab2ed26cc543698ddfef2d2736ebf506e773b6a2f6d1dd0f6')

package() {
  npm install -g --no-audit --no-fund --prefix "$pkgdir/usr" "$srcdir/$pkgname-$pkgver.tgz"
  # npm leaves files owned by the build user, pacman wants root.
  chown -R root:root "$pkgdir"

  local cli="$pkgdir/usr/lib/node_modules/@halitsever/claudegrid/dist/cli.js"
  install -d "$pkgdir/usr/share/bash-completion/completions" "$pkgdir/usr/share/zsh/site-functions" "$pkgdir/usr/share/fish/vendor_completions.d"
  node "$cli" completion bash > "$pkgdir/usr/share/bash-completion/completions/claudegrid"
  node "$cli" completion zsh > "$pkgdir/usr/share/zsh/site-functions/_claudegrid"
  node "$cli" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/claudegrid.fish"
  install -Dm644 "$pkgdir/usr/lib/node_modules/@halitsever/claudegrid/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgdir/usr/lib/node_modules/@halitsever/claudegrid/docs/public/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/claudegrid.svg"
  # Konsole reads profiles only at startup, so shipping this one lets claudegrid open tabs right away.
  printf '[General]\nName=claudegrid\nCommand=/usr/bin/claudegrid pane --konsole-tab\nLocalTabTitleFormat=▦ claudegrid\nRemoteTabTitleFormat=▦ claudegrid\n' | install -Dm644 /dev/stdin "$pkgdir/usr/share/konsole/claudegrid.profile"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/claudegrid.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=claudegrid
GenericName=Claude Code grid
Comment=Open a grid of Claude Code agents
Exec=claudegrid ui
Icon=claudegrid
Terminal=false
Categories=Development;Utility;
StartupWMClass=claudegrid
DESKTOP
}
