{
  "name": "@halitsever/claudegrid",
  "version": "1.5.0",
  "description": "Run several Claude Code agents side by side in one terminal window: Konsole, iTerm2, tmux, kitty and WezTerm grids on Linux and macOS, with per-pane prompts, presets, git worktrees and a desktop app.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "ai-agents",
    "coding-agent",
    "multi-agent",
    "terminal",
    "tmux",
    "konsole",
    "kitty",
    "wezterm",
    "git-worktree",
    "cli",
    "iterm2",
    "macos",
    "linux"
  ],
  "homepage": "https://halitsever.github.io/claudegrid/",
  "bugs": "https://github.com/halitsever/claudegrid/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halitsever/claudegrid.git"
  },
  "license": "MIT",
  "author": "Halit Sever",
  "type": "module",
  "bin": {
    "claudegrid": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "docs/public/schema.json",
    "docs/public/logo.svg",
    "docs/public/logo-512.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
